<h2>User Details</h2>

<div class="card card-header results-block">
  <div class="col-9">
    <div class="card mt-3">
      <div class="card-body">
        <h4 class="card-title">
          <span class="badge bg-primary me-2"><%= @user.email %></span>
          <span class="text-muted fs-6"><%= @user.first_name %> <%= @user.last_name %></span>
        </h4>
      </div>
    </div>
  </div>
</div>
